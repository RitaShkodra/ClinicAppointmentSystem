generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("RECEPTIONIST") // ADMIN | RECEPTIONIST | DOCTOR | PATIENT
  createdAt DateTime @default(now())
  deletedAt DateTime?

  doctorId  Int?
  patientId Int?

  doctor    Doctor?  @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  refreshTokens RefreshToken[]
}

model Patient {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  phone     String
  email     String?  @unique
  createdAt DateTime @default(now())
  deletedAt DateTime?

  users     User[]   // one patient can technically have multiple users if needed

  appointments Appointment[]
}

model Doctor {
  id              Int      @id @default(autoincrement())
  firstName       String
  lastName        String
  specialization  String
  email           String?  @unique
  phone           String?
  availability    String?
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  users           User[]   // doctor linked through user

  appointments    Appointment[]
}

model Appointment {
  id        Int      @id @default(autoincrement())
  dateTime  DateTime
  duration  Int      @default(30)
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  patientId Int
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  doctorId  Int
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([dateTime])
  @@index([doctorId, dateTime])
  @@index([patientId, dateTime])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}